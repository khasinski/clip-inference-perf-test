{
    "name": "fast-clip/php-server",
    "description": "PHP ONNX CLIP inference server",
    "require": {
        "php": ">=8.1",
        "ankane/onnxruntime": "^0.2",
        "codewithkyrian/transformers": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "FastClip\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "codewithkyrian/transformers-libsloader": true
        }
    }
}
